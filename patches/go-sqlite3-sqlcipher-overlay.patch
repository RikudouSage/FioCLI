+
+func sqlite3SQLCipherKeyLiteral(key string) string {
+	if len(key) >= 3 && (key[0] == 'x' || key[0] == 'X') && key[1] == '\'' && key[len(key)-1] == '\'' {
+		return `"` + strings.ReplaceAll(key, `"`, `""`) + `"`
+	}
+
+	return "'" + strings.ReplaceAll(key, "'", "''") + "'"
+}
 
